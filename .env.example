# Contoh konfigurasi environment. Aman di-commit (tanpa rahasia).
# Salin ke .env.local untuk kebutuhan lokal; .env.local sudah di-gitignore.

# URL publik dipilih otomatis dari mode:
#   npm run dev / npm run build:staging -> https://beesmart.protechid.cloud/app/
#   npm run build                        -> https://beesmart.id/app/
# Override hanya bila diperlukan (misal di CI):
# VITE_APP_URL=https://beesmart.id/app/

# Kunci API Gemini bersifat rahasia -> isi di .env.local, jangan di-commit.
# GEMINI_API_KEY=
