{
  "name": "beesmart-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "php -S 127.0.0.1:8088 router.php & vite --mode staging --port 3006 --host 0.0.0.0",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:php": "node scripts/checks/php_lint.mjs",
    "check:build": "node scripts/checks/check_build_urls.mjs",
    "verify": "npm run lint && npm run lint:php && npm run build && npm run check:build",
    "verify:staging": "npm run lint && npm run lint:php && npm run build:staging && node scripts/checks/check_build_urls.mjs staging"
  },
  "dependencies": {
    "@google/genai": "1.3.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/qrcode": "^1.5.6",
    "approve": "^0.0.12",
    "esbuild": "^0.28.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "scripts": "^0.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
